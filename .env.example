# Vault env vars
# Copy to .env.local for local dev. Set these in Vercel Project Settings for prod.

# --- Supabase ---
# From Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Has elevated permissions. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (embeddings only) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Anthropic (AI search ranker) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- LemonSqueezy ---
# Create Vault subscription product at cheesyboy.lemonsqueezy.com first.
# Until you do, the paywall buttons render in a "Coming soon" state.
# Buy URLs are the LS checkout URLs for each variant.
NEXT_PUBLIC_LS_CHECKOUT_MONTHLY_URL=
NEXT_PUBLIC_LS_CHECKOUT_ANNUAL_URL=
# Vault product UUID (Settings → Products → your product → ... → Copy ID)
LS_PRODUCT_UUID=
# Webhook signing secret (Settings → Webhooks → your webhook)
LS_WEBHOOK_SECRET=
# Store API key (Settings → API)
LS_API_KEY=

# --- GitHub (scraper, optional but strongly recommended) ---
# Unauthenticated GitHub API: 60 req/hr. Authenticated: 5000 req/hr.
# Create a fine-grained PAT with public_repo scope.
GITHUB_TOKEN=

# --- App ---
# Used in magic-link redirects. Set to your full https URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
