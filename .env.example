# Vault env vars
# Copy to .env.local for local dev. Set these in Vercel Project Settings for prod.
# Audit basis: every process.env.X read by src/ or scripts/ is listed below.

# --- Supabase ---
# From Supabase project → Settings → API.
# NEXT_PUBLIC_SUPABASE_URL is read by the browser; SUPABASE_URL is an alias
# accepted by the scraper for parity with GitHub Actions secret naming.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Has elevated permissions. NEVER expose to the client.
# SUPABASE_SERVICE_ROLE_KEY is canonical; SUPABASE_SERVICE_KEY is an alias the
# scraper checks so GitHub Actions secrets can use the shorter name.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=

# --- OpenAI (embeddings only) ---
# https://platform.openai.com/api-keys
# Used by /api/search and the scraper to embed text via text-embedding-3-small.
OPENAI_API_KEY=

# --- Anthropic (AI search ranker) ---
# https://console.anthropic.com/settings/keys
# Used by /api/search to rank the top-5 pgvector candidates via claude-sonnet-4-6.
ANTHROPIC_API_KEY=

# --- LemonSqueezy ---
# Create the Vault subscription product at cheesyboy.lemonsqueezy.com first.
# Until you do, the paywall buttons render in a "Coming soon" state.
# Buy URLs are the per-variant LS checkout URLs.
NEXT_PUBLIC_LS_CHECKOUT_MONTHLY_URL=
NEXT_PUBLIC_LS_CHECKOUT_ANNUAL_URL=
# Variant IDs distinguish monthly vs annual when the webhook fires.
# LS dashboard → Product → Variant → Copy ID.
LS_VARIANT_MONTHLY=
LS_VARIANT_ANNUAL=
# Vault product UUID (Settings → Products → your product → ... → Copy ID).
LS_PRODUCT_UUID=
# Webhook signing secret (Settings → Webhooks → your webhook).
LS_WEBHOOK_SECRET=
# Store API key (Settings → API).
LS_API_KEY=

# --- GitHub (scraper, optional but strongly recommended) ---
# Unauthenticated GitHub API: 60 req/hr. Authenticated: 5000 req/hr.
# Create a fine-grained PAT with public_repo scope.
GITHUB_TOKEN=

# --- Plausible analytics ---
# Set to your Plausible site domain. When empty, the analytics script
# is not injected and no data is collected. No cookies.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=vault.cheesyboy.dev

# --- App ---
# Used in magic-link redirects. Set to your full https URL in production
# (e.g. https://vault.cheesyboy.dev). Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tally (email capture) ---
# Create a Tally form named "Vault weekly digest" at https://tally.so.
# Add an Email field, enable "Pre-fill from URL parameter" with the key `email`.
# Then copy the form short ID (the part after /r/ in the public URL) here.
# When empty, the email-capture CTA hides itself across the site.
NEXT_PUBLIC_TALLY_VAULT_FORM_ID=

# --- Admin (moderation queue) ---
# Email address allowed to access /admin. Compared against the logged-in
# Supabase user.email exactly. Default if unset is stephen@bubblesllc.com.
ADMIN_EMAIL=stephen@bubblesllc.com
